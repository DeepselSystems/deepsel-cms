---
import type { PageData } from "@deepsel/cms-utils";
import { getAttachmentRelativeUrl } from "@deepsel/cms-utils";
import Page from "./components/Page";
import "@deepsel/cms-utils/styles.css";
import "./main.css";

interface Props {
    data: PageData;
}

const { data } = Astro.props;

const seoMeta = data.seo_metadata;
// featured_image_version_name = AttachmentLocaleVersionModel.name (SEO-friendly storage key).
// Converted to absolute URL because og:image requires a full URL.
const ogImageUrl = seoMeta?.featured_image_version_name
  ? new URL(getAttachmentRelativeUrl(seoMeta.featured_image_version_name), Astro.url).href
  : null;
---

<!DOCTYPE html>
<html lang={data.lang || 'en'} data-theme="starter_react">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.seo_metadata?.title || ''}</title>
    <meta name="description" content={data.seo_metadata?.description || ''} />
    <meta name="robots" content={data.seo_metadata?.allow_indexing ? 'index, follow' : 'noindex, nofollow'} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta property="og:title" content={data.seo_metadata?.title || ''} />
    <meta property="og:description" content={data.seo_metadata?.description || ''} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
</head>
<body>
    <Page client:load pageData={data} />
</body>
</html>
